//			hsync-len = <10>;
//			vback-porch = <23>;
//			vfront-porch = <15>;
//			vsync-len = <5>;
//			de-active = <1>;
//			pixelclk-active = <1>;
//		};
//
//		port {
//			panel_lvds_in: endpoint {
//				remote-endpoint = <&lvds_out>;
//			};
//		};
//	};
};

//&ldb {
//	status = "okay";
//
//	lvds-channel@0 {
//		status = "okay";
//
